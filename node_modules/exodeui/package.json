{
  "name": "exodeui",
  "version": "7.2.26",
  "description": "React Runtime for ExodeUI Animation Engine",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./vite-plugin": {
      "require": "./vite-plugin.js"
    }
  },
  "files": [
    "dist",
    "vite-plugin.js",
    "README.md"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-dom": ">=16.8.0",
    "three": ">=0.150.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.9",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.186.0",
    "jsdom": "^27.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.186.0",
    "typescript": "^5.0.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^3.0.0",
    "vitest": "^4.0.17"
  },
  "dependencies": {
    "@chenglou/pretext": "^0.0.3",
    "@dimforge/rapier2d-compat": "^0.19.3",
    "@types/lz-string": "1.3.34",
    "fflate": "^0.8.2",
    "lz-string": "1.5.0",
    "msgpackr": "^1.11.9",
    "three": ">=0.150.0",
    "three-bvh-csg": "^0.0.18"
  }
}
